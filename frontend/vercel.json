{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/:path((?!$).*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/sign-up", "destination": "/index.html" },
    { "source": "/verify-signup", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/settings/verify-email", "destination": "/index.html" },
    { "source": "/settings/confirm-delete", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/check-email", "destination": "/index.html" },
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/feed", "destination": "/index.html" },
    { "source": "/requests", "destination": "/index.html" },
    { "source": "/create", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/inbox", "destination": "/index.html" },
    { "source": "/inbox/:id", "destination": "/index.html" },
    { "source": "/listing/:id/edit", "destination": "/index.html" },
    { "source": "/listing/:id", "destination": "/index.html" },
    { "source": "/criteria/:id/edit", "destination": "/index.html" },
    { "source": "/criteria/:id", "destination": "/index.html" }
  ]
}
