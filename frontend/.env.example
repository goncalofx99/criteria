# Live local development. For isolated UI review, use ?review=1 with the Vite dev server.
VITE_API_URL=http://localhost:4000
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:4000/graphql

# Optional local defaults. Configure a tile provider and its required attribution
# for each production deployment; these values are embedded in the web bundle.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional browser-only Cloudflare Web Analytics. This site token is public
# configuration, not a secret. Leave unset until a site is provisioned and
# automatic Cloudflare injection is disabled. The beacon loads only after a
# visitor opts in on criteria-app.com; it never loads in Capacitor/review mode.
# VITE_CLOUDFLARE_WEB_ANALYTICS_TOKEN=your-cloudflare-web-analytics-site-token
