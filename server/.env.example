# ─── Database (Neon Postgres) ──────────────────────────────────────────────────
# Pooled connection — used by the running server
DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct connection — used by drizzle-kit for migrations (DDL)
MIGRATION_URL=postgresql://neondb_owner:xxx@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-chars

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Password recovery, email changes, and account deletion confirmations —
# configure a verified sender in Resend before enabling these actions.
RESEND_API_KEY=re_xxx
PASSWORD_RESET_FROM=security@criteria-app.com

# ─── Cloudflare R2 (S3-compatible object storage) ─────────────────────────────
# In addition to upload access, this credential needs ListObjects and
# DeleteObjects to erase owned photos after account deletion.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=criteria-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Optional public API origin for Google's callback. Set this to the deployed API
# or an HTTPS tunnel to this same local API process for physical-device development,
# without a trailing path. OAuth state is held in this process's memory.
# Register exactly PUBLIC_API_URL/auth/google/callback in Google Cloud.
# PUBLIC_API_URL=https://api.example.com
# Frontend origin — required in production for CORS
FRONTEND_URL=https://criteria-app.com
