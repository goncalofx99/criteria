# ─── Database ─────────────────────────────────────────────────────────────────
#
# Supabase gives you two connection strings — use the right one per purpose.
#
# Transaction Pooler (port 6543) — used by the running server.
# Supabase dashboard → Settings → Database → Connection pooling → Transaction mode → URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Direct Connection (port 5432) — used by drizzle-kit for migrations only.
# Supabase dashboard → Settings → Database → Connection string → URI tab
MIGRATION_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Supabase dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Frontend origin — required in production for CORS.
# In development this is not required (all origins are allowed).
FRONTEND_URL=https://your-app.vercel.app
